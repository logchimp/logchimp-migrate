{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "logchimp-migrate",
  "version": "0.0.3",
  "description": "Migrate feedback data from other providers into LogChimp",
  "type": "module",
  "bin": {
    "logchimp-migrate": "./bin/logchimp-migrate"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/index.ts --outfile bin/logchimp-migrate",
    "build:all": "bun run scripts/build-all.ts",
    "prepublishOnly": "node scripts/copy-binary.mjs"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "repository": {
    "url": "https://github.com/logchimp/logchimp-migrate"
  }
}

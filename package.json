{
  "name": "logchimp-migrate",
  "version": "0.1.0",
  "description": "Migrate feedback data from other providers into LogChimp",
  "type": "module",
  "bin": {
    "logchimp-migrate": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/index.ts --outfile dist/logchimp-migrate"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
